{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" }
  ],
  "title": "NutriLens — Receipt Pipeline",
  "uid": "nutrilens-receipt-pipeline",
  "description": "Scanner duration, normalization timing, and item extraction metrics",
  "timezone": "Asia/Kolkata",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["nutrilens", "receipt"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Receipts Processed (window)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Scanner Duration",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [$__range])"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 15000 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Normalization Duration",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.normalization_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [$__range])"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3000 },
              { "color": "red", "value": 8000 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Items per Receipt",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `items=(?P<items>[0-9]+)` | unwrap items [$__range])"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Scanner Duration (ms)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.50, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.99, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P99"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Normalization Duration (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.50, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.normalization_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.normalization_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.99, {namespace=\"nutrilens\"} | json | event =~ `receipt\\.normalization_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "P99"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Matcher + Converter Duration (ms)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `normalizer\\.match_batch_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "Matcher avg"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `normalizer\\.conversion_batch_completed.*` | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | unwrap duration_ms [10m])",
          "legendFormat": "Converter avg"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Items Extracted per Receipt",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `items=(?P<items>[0-9]+)` | unwrap items [10m])",
          "legendFormat": "Avg items"
        },
        {
          "refId": "B",
          "expr": "max_over_time({namespace=\"nutrilens\"} | json | event =~ `receipt\\.scanner_completed.*` | regexp `items=(?P<items>[0-9]+)` | unwrap items [10m])",
          "legendFormat": "Max items"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent Pipeline Logs",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"nutrilens\"} | json | event =~ `receipt\\.|normalizer\\.`",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
